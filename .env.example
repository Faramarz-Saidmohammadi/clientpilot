# Database
MONGODB_URI=mongodb://127.0.0.1:27017/clientpilot

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
